{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "paths": {
      "@base/api/*": ["./apps/base/api/*"],
      "@base/web/*": ["./apps/base/web/*"],
      "@base/infra/*": ["./infra/base/*"],
      "@scorely/api/*": ["./apps/scorely/api/*"],
      "@scorely/web/*": ["./apps/scorely/web/*"],
      "@scorely/contracts/*": ["./apps/scorely/contracts/*"],
      "@scorely/infra/*": ["./infra/scorely/*"],
      "@infra/shared/*": ["./infra/shared/*"],
      "@checks/*": ["./checks/*"]
    }
  }
}
