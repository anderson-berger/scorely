{
  "name": "app-base",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspace",
  "remoteUser": "node",
  "postCreateCommand": "npm ci",
  "forwardPorts": [5173, 3000, 5174, 3010, 4566],
  "portsAttributes": {
    "5173": { "label": "base · web", "onAutoForward": "notify" },
    "3000": { "label": "base · api", "onAutoForward": "silent" },
    "5174": { "label": "scorely · web", "onAutoForward": "notify" },
    "3010": { "label": "scorely · api", "onAutoForward": "silent" },
    "4566": { "label": "LocalStack", "onAutoForward": "silent" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["biomejs.biome", "Vue.volar", "vitest.explorer", "anthropic.claude-code"],
      "settings": {
        "editor.defaultFormatter": "biomejs.biome",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": { "source.organizeImports.biome": "explicit" }
      }
    }
  }
}
