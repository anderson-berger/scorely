# API (serverless offline) — dentro do devcontainer o endpoint é http://dynamodb:8000 (DynamoDB Local)
DYNAMODB_ENDPOINT=http://localhost:8000
# S3 local (S3Mock, só scorely): a api fala com S3_ENDPOINT e assina as URLs com S3_PUBLIC_ENDPOINT,
# que é o endereço que o navegador alcança. Dentro do devcontainer: S3_ENDPOINT=http://s3:9090.
S3_ENDPOINT=http://localhost:9090
S3_PUBLIC_ENDPOINT=http://localhost:9090
AWS_REGION=sa-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# Serverless Framework v4 exige auth até no offline. Uma key pessoal serve para o monorepo todo.
# No devcontainer, coloque em .devcontainer/.env (lido pelo docker-compose). No CI, use o secret do GitHub.
SERVERLESS_ACCESS_KEY=
# Web: a URL da api é por projeto (fallback em apps/<projeto>/web/src/lib/http.ts).
# Para sobrescrever, crie apps/<projeto>/web/.env com VITE_API_URL=...
